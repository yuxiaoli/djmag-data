{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-attributed Vegas venue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "listing_category",
    "facts",
    "description",
    "sections",
    "links",
    "source",
    "quality",
    "field_provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "listing_category": {
      "enum": [
        "nightclub",
        "dayclub"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "heading",
          "source_url"
        ],
        "properties": {
          "heading": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source",
              "video",
              "map",
              "virtual_tour",
              "image"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "url",
        "observed_at"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "listing_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "source_conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Retained review notes about conflicting or unreliable source content; not a new source assertion."
        },
        "source_conflicts_observed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Source observation timestamp associated with retained review notes, preserved unchanged on refresh; not the time a human reviewed them."
        }
      }
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source_url",
          "retrieved_at"
        ],
        "properties": {
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "directory_facts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
